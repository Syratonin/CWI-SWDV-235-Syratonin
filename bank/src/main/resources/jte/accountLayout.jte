@param String title
@param gg.jte.Content account
@param gg.jte.Content detail

<!DOCTYPE html>
<html>
<head>
    <title>${title}</title>
</head>
<body>

    <h1>${title}</h1>

    <div class="account">
        ${account}
    </div>

    <div class="detail">
        ${detail}
    </div>

</body>
</html>